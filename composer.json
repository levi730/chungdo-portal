{
    "name": "chungdo/portal",
    "type": "project",
    "description": "Chung Do Association portal: membership, tournament registration, payments, and mobile check-in.",
    "keywords": [
        "laravel",
        "tournament",
        "martial-arts"
    ],
    "repositories": [
        {
            "type": "github",
            "url": "https://github.com/levi730/fortify-tabler"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/sendportal-core.git"
        }
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "anhskohbo/no-captcha": "^3.6",
        "beganovich/snappdf": "^5",
        "doctrine/dbal": "^4",
        "guzzlehttp/guzzle": "^7.0.1",
        "inertiajs/inertia-laravel": "^2.0",
        "kirschbaum-development/eloquent-power-joins": "^4.2",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/cashier": "^15.2",
        "laravel/framework": "12.*",
        "laravel/passport": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/csv": "^9.23",
        "league/glide-symfony": "^2.0",
        "maatwebsite/excel": "^3.1",
        "mettle/sendportal-core": "dev-l12-compatibility",
        "mikehaertl/php-pdftk": "^0.13",
        "pkpass/pkpass": "^2.0",
        "proxeuse/fortify-tabler": "@dev",
        "rappasoft/laravel-livewire-tables": "^3.2",
        "ronvanderheijden/openid-connect": "^1.2",
        "spatie/laravel-glide": "^3.8",
        "spatie/laravel-markdown": "^2.4",
        "spatie/laravel-medialibrary": "^11.9",
        "spatie/laravel-permission": "^6.2",
        "spatie/temporary-directory": "^2",
        "stayallive/laravel-mail-css-inliner": "^4.2",
        "stripe/stripe-php": "^16",
        "werneckbh/laravel-qr-code": "^0.1.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.7",
        "spatie/laravel-ignition": "^2.4",
        "spatie/ray": "^1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/passport",
                "proxeuse/fortify-tabler"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
