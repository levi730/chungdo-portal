APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chungdo
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

EVENT_REFUND_NOTIFY_EMAILS=admin@example.com

TYPST_BIN=typst

# Mobile wallet passes (event check-in tickets). Buttons only appear when a
# platform is fully configured. See config/wallet.php.
# Apple Wallet: password for the Pass Type ID .p12 (regenerate the cert when it expires).
WALLET_APPLE_CERT_PASSWORD=
# Supply the .p12 either as base64 (best for containers; macOS: base64 -i cert.p12 | tr -d '\n')
# or as a file path. Base64 takes precedence.
# WALLET_APPLE_CERT_BASE64=
# WALLET_APPLE_CERT_PATH=  # defaults to resources/certs/ChungDoEventPassCert.p12
# WALLET_APPLE_PASS_TYPE_ID=pass.org.chungdo.eventpass
# WALLET_APPLE_TEAM_ID=YOURTEAMID
# Google Wallet: issuer id + service-account key. For containerized deploys,
# base64-encode the JSON key into one line (macOS: base64 -i key.json | tr -d '\n').
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_SERVICE_ACCOUNT_BASE64=
# Alternatives to the base64 form (use one):
# WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=   # raw JSON string
# WALLET_GOOGLE_SERVICE_ACCOUNT=        # path to a JSON key file
# WALLET_GOOGLE_CLASS_SUFFIX=chungdo_event
WALLET_ORG_NAME="Chung Do Association"

# Stripe — the association's account (also what Laravel Cashier uses).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_KEY="${STRIPE_KEY}"

# Additional Stripe account an event can be pointed at (events.stripe_account).
# Leave unset and the option is hidden from the event form.
STRIPE_MAIN_SCHOOL_KEY=
STRIPE_MAIN_SCHOOL_SECRET=
STRIPE_MAIN_SCHOOL_WEBHOOK_SECRET=

# Which account new events default to. Must be a key in config services.stripe.accounts.
STRIPE_DEFAULT_ACCOUNT=association

# Zulip REST API — the portal -> Zulip sync (belt rank, user groups, committee
# channels). Leave ZULIP_SITE unset to disable the sync and its nightly run.
ZULIP_SITE=
ZULIP_BOT_EMAIL=
ZULIP_BOT_API_KEY=
ZULIP_BELT_RANK_FIELD="Belt rank"

# Channel folder committee channels are filed under (the "COMMITTEES" folder).
ZULIP_COMMITTEE_FOLDER_ID=
# Create a private channel for a committee that doesn't have one yet.
ZULIP_CREATE_COMMITTEE_CHANNELS=true

# Google Static Maps, used only to snapshot each event's location once so the
# dashboard can show a map picture without embedding a live map in every card.
# One API call per venue, cached on disk; unset means cards show the address.
# Restrict this key by IP (it is used server-side) and set a quota cap.
GOOGLE_MAPS_KEY=

# Show the Store item in the navigation. Set to false to keep the store out of
# sight while it is being set up. Hides the MENU ONLY — /store stays reachable
# by URL, and /admin/products still works for store.manage holders.
STORE_MENU=true
